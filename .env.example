# LFINFO / Vendure — copiez ce fichier vers .env puis complétez les secrets.
APP_ENV=production
PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_NAME=A REMPLIR
DB_USERNAME=A REMPLIR
DB_PASSWORD=A REMPLIR
DB_SCHEMA=public
SUPERADMIN_USERNAME=A REMPLIR
SUPERADMIN_PASSWORD=A REMPLIR
COOKIE_SECRET=A REMPLIR
CORS_ORIGINS=https://adminshop.lfinfo.be

# TD SYNNEX Bridge API. Fournis par le portail développeur / votre chargé de compte TD SYNNEX.
TD_SYNNEX_CLIENT_ID=A REMPLIR
TD_SYNNEX_CLIENT_SECRET=A REMPLIR
# Racine API : le plugin ajoute /eu automatiquement. Ne la modifiez que sur instruction TD SYNNEX.
TD_SYNNEX_API_URL=https://api.tdsynnex.com

# Icecat Product JSON API (facultatif). Créez les deux dans MyIcecat > Access Tokens.
# Ils restent uniquement sur le serveur et sont envoyés en en-têtes api-token/content-token.
ICECAT_API_TOKEN=A REMPLIR
ICECAT_CONTENT_TOKEN=A REMPLIR
# Code Icecat, par défaut FR_BE. Exemple : EN, NL, FR_BE.
ICECAT_LANGUAGE=FR_BE
