# LFINFO / Vendure — copiez ce fichier vers .env puis complétez les secrets.
APP_ENV=production
PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_NAME=A REMPLIR
DB_USERNAME=A REMPLIR
DB_PASSWORD=A REMPLIR
DB_SCHEMA=public
SUPERADMIN_USERNAME=A REMPLIR
SUPERADMIN_PASSWORD=A REMPLIR
COOKIE_SECRET=A REMPLIR
CORS_ORIGINS=https://adminshop.lfinfo.be

# TD SYNNEX Bridge API. Fournis par le portail développeur / votre chargé de compte TD SYNNEX.
TD_SYNNEX_CLIENT_ID=A REMPLIR
TD_SYNNEX_CLIENT_SECRET=A REMPLIR
# Valeur connue pour l’API européenne ; ne la modifiez que sur instruction TD SYNNEX.
TD_SYNNEX_API_URL=https://api.tdsynnex.com

# Icecat est facultatif. Sans ces variables, l’enrichissement est ignoré sans empêcher l’import.
ICECAT_USERNAME=A REMPLIR
ICECAT_PASSWORD=A REMPLIR
# Endpoint JSON autorisé par votre contrat Icecat (ne pas inventer une URL).
ICECAT_LOOKUP_URL=A REMPLIR
