{{> header title="Confirmation de commande LFINFO" }}

<mj-raw>
<style type="text/css">
  .order-table { width:100%; border-collapse:collapse; }
  .order-table td { border-bottom:1px solid #e2e8f0; vertical-align:middle; }
  .order-table .amount { text-align:right; white-space:nowrap; }
  .summary-table { width:100%; border-collapse:collapse; }
  .summary-table td { padding:7px 0; }
  .summary-table .amount { text-align:right; white-space:nowrap; }
  .summary-table .total td { border-top:2px solid #cbd5e1; padding-top:12px; font-size:17px; font-weight:700; color:#14213d; }
  .address { list-style:none; margin:0; padding:0; }
</style>
</mj-raw>

<mj-section background-color="#ffffff" padding="32px 32px 18px">
  <mj-column>
    <mj-text font-size="23px" font-weight="800" color="#14213d" padding="0 0 8px">Merci pour votre commande !</mj-text>
    <mj-text padding="0">Bonjour {{ order.customer.firstName }} {{ order.customer.lastName }}, votre commande a bien été enregistrée. Voici son récapitulatif.</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#eef5ff" padding="18px 24px">
  <mj-column width="33.33%">
    <mj-text align="center" color="#64748b" font-size="11px" font-weight="700" text-transform="uppercase" padding="0">Commande</mj-text>
    <mj-text align="center" color="#14213d" font-size="15px" font-weight="700" padding="4px 0 0">{{ order.code }}</mj-text>
  </mj-column>
  <mj-column width="33.33%">
    <mj-text align="center" color="#64748b" font-size="11px" font-weight="700" text-transform="uppercase" padding="0">Date</mj-text>
    <mj-text align="center" color="#14213d" font-size="14px" font-weight="700" padding="4px 0 0">{{ formatDate order.orderPlacedAt }}</mj-text>
  </mj-column>
  <mj-column width="33.33%">
    <mj-text align="center" color="#64748b" font-size="11px" font-weight="700" text-transform="uppercase" padding="0">Total TVAC</mj-text>
    <mj-text align="center" color="#0757c9" font-size="17px" font-weight="800" padding="4px 0 0">{{ formatMoney order.totalWithTax order.currencyCode 'fr' }}</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#ffffff" padding="28px 32px 12px">
  <mj-column>
    <mj-text font-size="18px" font-weight="800" color="#14213d" padding="0 0 12px">Votre commande</mj-text>
    <mj-table cellpadding="8px" css-class="order-table">
      {{#each order.lines }}
      <tr>
        <td width="58">
          {{#if featuredAsset.preview}}<img alt="{{ productVariant.name }}" style="display:block;width:46px;height:46px;object-fit:contain;border-radius:6px" src="{{ featuredAsset.preview }}?w=92&h=92" />{{/if}}
        </td>
        <td>
          <strong style="color:#172033">{{ productVariant.product.name }}</strong><br />
          <span style="color:#64748b;font-size:12px">{{ productVariant.name }} · Qté {{ quantity }}</span>
        </td>
        <td class="amount"><strong>{{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'fr' }}</strong></td>
      </tr>
      {{/each}}
    </mj-table>
  </mj-column>
</mj-section>

<mj-section background-color="#ffffff" padding="8px 32px 28px">
  <mj-column width="46%"><mj-spacer height="1px" /></mj-column>
  <mj-column width="54%">
    <mj-table cellpadding="0" css-class="summary-table">
      <tr><td>Sous-total</td><td class="amount">{{ formatMoney order.subTotalWithTax order.currencyCode 'fr' }}</td></tr>
      {{#each order.discounts }}
      <tr><td style="color:#0757c9">{{ description }}</td><td class="amount" style="color:#0757c9">{{ formatMoney amount ../order.currencyCode 'fr' }}</td></tr>
      {{/each}}
      {{#each shippingLines }}
      <tr><td>Livraison ({{ shippingMethod.name }})</td><td class="amount">{{ formatMoney priceWithTax ../order.currencyCode 'fr' }}</td></tr>
      {{/each}}
      <tr class="total"><td>Total TVAC</td><td class="amount">{{ formatMoney order.totalWithTax order.currencyCode 'fr' }}</td></tr>
    </mj-table>
  </mj-column>
</mj-section>

{{#with order.shippingAddress }}
<mj-section background-color="#f8fafc" padding="20px 32px">
  <mj-column>
    <mj-text font-size="15px" font-weight="800" color="#14213d" padding="0 0 7px">Coordonnées de livraison</mj-text>
    <mj-text color="#475569" font-size="13px" padding="0">
      <strong>{{ fullName }}</strong><br />
      {{#if company}}{{ company }}<br />{{/if}}
      {{#if streetLine1}}{{ streetLine1 }}<br />{{/if}}
      {{#if streetLine2}}{{ streetLine2 }}<br />{{/if}}
      {{#if postalCode}}{{ postalCode }} {{/if}}{{#if city}}{{ city }}<br />{{/if}}
      {{#if province}}{{ province }}<br />{{/if}}
      {{#if country}}{{ country }}{{/if}}
    </mj-text>
  </mj-column>
</mj-section>
{{/with}}

<mj-section background-color="#ffffff" padding="24px 32px 30px">
  <mj-column>
    <mj-text font-size="16px" font-weight="800" color="#14213d" padding="0 0 6px">Produits numériques</mj-text>
    <mj-text color="#475569" font-size="13px" padding="0">Pour les licences et logiciels numériques, les informations d'activation ou de téléchargement sont communiquées selon le traitement prévu pour le produit concerné.</mj-text>
  </mj-column>
</mj-section>

{{> footer }}
