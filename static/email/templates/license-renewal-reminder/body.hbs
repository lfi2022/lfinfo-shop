{{> header title=subject }}

<mj-section
  background-color="#ffffff"
  padding="30px 25px 10px 25px"
>
  <mj-column>

    <mj-text
      font-size="18px"
      font-weight="600"
      color="#111111"
      padding-bottom="10px"
    >
      Bonjour {{ customer.firstName }},
    </mj-text>

    <mj-text
      font-size="15px"
      line-height="24px"
      color="#444444"
    >
      Votre licence
      <strong>{{ license.productName }}</strong>
      arrive bientôt à expiration.
    </mj-text>

  </mj-column>
</mj-section>


<mj-section
  background-color="#f5f5f5"
  border-radius="8px"
  padding="20px 25px"
>
  <mj-column>

    <mj-text
      font-size="14px"
      color="#666666"
      padding-bottom="5px"
    >
      Produit
    </mj-text>

    <mj-text
      font-size="17px"
      font-weight="600"
      color="#111111"
      padding-top="0"
      padding-bottom="5px"
    >
      {{ license.productName }}
    </mj-text>


    {{#if license.variantName}}
      <mj-text
        font-size="14px"
        color="#666666"
        padding-top="0"
      >
        {{ license.variantName }}
      </mj-text>
    {{/if}}


    {{#if license.maskedLicenseKey}}

      <mj-divider
        border-color="#dddddd"
        padding="15px 0"
      />

      <mj-text
        font-size="14px"
        color="#666666"
        padding-bottom="5px"
      >
        Licence
      </mj-text>

      <mj-text
        font-size="15px"
        font-family="monospace"
        color="#111111"
        padding-top="0"
      >
        {{ license.maskedLicenseKey }}
      </mj-text>

    {{/if}}


    <mj-divider
      border-color="#dddddd"
      padding="15px 0"
    />


    <mj-text
      font-size="14px"
      color="#666666"
      padding-bottom="5px"
    >
      Date d'expiration
    </mj-text>

    <mj-text
      font-size="20px"
      font-weight="700"
      color="#111111"
      padding-top="0"
    >
      {{ license.expiresAtFormatted }}
    </mj-text>


    <mj-text
      font-size="14px"
      color="#666666"
      padding-top="5px"
    >
      Il reste environ
      <strong>{{ daysRemaining }} jour(s)</strong>
      avant l'expiration de votre licence.
    </mj-text>

  </mj-column>
</mj-section>


<mj-section
  background-color="#ffffff"
  padding="20px 25px"
>
  <mj-column>

    {{#if manual}}

      <mj-text
        font-size="13px"
        color="#777777"
        padding-bottom="15px"
      >
        Ce rappel a été envoyé manuellement
        par notre service client.
      </mj-text>

    {{/if}}


    <mj-text
      font-size="15px"
      line-height="24px"
      color="#444444"
    >
      Afin d'éviter toute interruption,
      nous vous conseillons de prévoir
      le renouvellement de votre licence
      avant cette date.
    </mj-text>


    <mj-button
      href="{{ shopUrl }}"
      background-color="#111111"
      color="#ffffff"
      border-radius="6px"
      font-size="15px"
      font-weight="600"
      padding-top="15px"
    >
      Accéder à LFINFO
    </mj-button>


    <mj-text
      font-size="13px"
      line-height="20px"
      color="#777777"
      padding-top="15px"
    >
      Si vous avez besoin d'aide pour
      renouveler votre licence,
      notre équipe reste à votre disposition.
    </mj-text>

  </mj-column>
</mj-section>

{{> footer }}
