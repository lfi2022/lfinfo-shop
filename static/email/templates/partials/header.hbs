<mjml>
  <mj-head>
    <mj-title>{{ title }}</mj-title>
    <mj-preview>{{ title }} — LFINFO</mj-preview>

    <mj-attributes>
      <mj-all font-family="Inter, Arial, Helvetica, sans-serif" />

      <mj-text
        color="#172033"
        font-size="15px"
        line-height="1.6"
      />

      <mj-button
        background-color="#1768e5"
        color="#ffffff"
        border-radius="8px"
        font-weight="700"
        inner-padding="13px 24px"
      />

      <mj-section padding="0" />
    </mj-attributes>

    <mj-style inline="inline">
      .muted {
        color: #64748b;
      }

      .card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
      }

      .link {
        color: #0757c9;
      }
    </mj-style>
  </mj-head>

  <mj-body
    background-color="#f4f7fb"
    width="680px"
  >

    <mj-section
      background-color="#071a36"
      padding="20px 28px"
      border-top="4px solid #1768e5"
    >
      <mj-column>

        <mj-image
          src="https://adminshop.lfinfo.be/assets/email/logo.webp"
          alt="LFINFO"
          width="170px"
          align="left"
          padding="0"
        />

        <mj-text
          align="left"
          color="#dbeafe"
          font-size="12px"
          font-weight="600"
          padding="8px 0 0"
        >
          Solutions informatiques &amp; logiciels
        </mj-text>

      </mj-column>
    </mj-section>
